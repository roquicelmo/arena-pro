# Ambiente LOCAL de desenvolvimento e testes (nunca aponte para a produção).
# Copie para .env.local:  cp .env.local.example .env.local
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/sorteios_lagoa_dev"
DATABASE_URL_POOLED="postgresql://postgres:postgres@localhost:54329/sorteios_lagoa_dev"
# Banco usado pelo Playwright (recriado a cada execução).
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:54329/sorteios_lagoa_test"
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-local-gerado-com-openssl"
VITE_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Admin do seed local (valores de teste, somente para o banco local).
SEED_ADMIN_EMAIL="admin@sorteios.test"
SEED_ADMIN_PASSWORD="admin-local-123"
